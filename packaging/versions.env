# The versions that a release is built from. Each line is a Go module query:
# a tag, a commit or a branch.
#
# master is a placeholder: none of the three has a release yet with what the
# build needs (gaia --binary reva and --brand, reva's CLI with branding, the
# CLI plugins with cli/cernbox.toml). Pin each one when it has a release.
GAIA_VERSION=master
REVA_VERSION=master
REVA_PLUGINS_VERSION=master
